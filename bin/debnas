#!/bin/bash
# 功能：DebNAS CLI 调度器
# 说明：解析全局参数，路由到对应子命令
#
# 用法：
#   debnas                               # 启动交互菜单
#   debnas install <模块名>              # 安装指定模块
#   debnas run <模块名>                  # 执行指定模块
#   debnas config <key> [value]          # 查询或设置全局配置
#   debnas config list                   # 列出所有配置
#   debnas update [--tag <版本>]         # 更新 DebNAS（校验发布签名）
#   debnas check-update                  # 检查是否有新版本（只读）
#   debnas uninstall                     # 卸载 DebNAS
#   debnas doctor                        # 系统诊断
#   debnas files                         # 列出文件布局与修改过的系统文件
#   debnas cron add|remove|list          # 管理定时任务
#   debnas --help                        # 显示帮助
#   debnas --version                     # 显示版本

set -euo pipefail
IFS=$'\n\t'

# 获取项目根目录（解析符号链接，支持 /usr/local/bin/debnas 软链接调用）
_DEBNAS_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
_DEBNAS_ROOT="$(cd "${_DEBNAS_SCRIPT%/*}/.." && pwd)"  # readlink -f 输出绝对路径，参数展开取目录

# 加载统一库
source "${_DEBNAS_ROOT}/lib/bootstrap.sh"

# ==================== 子命令路由 ====================

# 子命令：menu（交互菜单）
cmd_menu() {
	unset _DEBNAS_BOOTSTRAPPED
	exec bash "${_DEBNAS_ROOT}/bin/menu.sh" "$@"
}

# 子命令：install / run <模块名>
cmd_install() {
	if [[ $# -eq 0 ]]; then
		log_error "需要指定模块名"
		echo "用法: debnas install <模块名>"
		echo ""
		echo "可用模块："
		discover_modules 2>/dev/null
		get_module_list | sort | while read -r mod; do
			local name
			name=$(get_module_field "$mod" "name" "$mod" 2>/dev/null)
			echo "  ${mod} - ${name}"
		done
		return 1
	fi

	local module_name="$1"
	shift

	unset _DEBNAS_BOOTSTRAPPED
	exec bash "${_DEBNAS_ROOT}/bin/module-runner.sh" "$module_name" "$@"
}

# 子命令：config <key> [value] | list
cmd_config() {
	local key="${1:-}"
	local value="${2:-}"

	# 无参数 → 显示用法帮助
	if [[ -z "$key" ]]; then
		echo "用法: debnas config <key> [value]"
		echo ""
		echo "操作:"
		echo "  debnas config list              列出所有配置"
		echo "  debnas config <key>             查询配置值"
		echo "  debnas config <key> <value>     设置配置"
		echo "  debnas config <key> --unset     删除配置"
		echo ""
		echo "配置项:"
		echo "  region      cn|global  网络环境（国内镜像 / 国际直连）"
		echo "  lang        zh|en      界面语言"
		echo "  file_logging 0|1        文件日志（0=禁用，1=启用）"
		return 0
	fi

	# list → 列出所有配置
	if [[ "$key" == "list" ]]; then
		echo "DebNAS 全局配置:"
		echo "──────────────────────────"
		local val
		val=$(config_read "global" "region" "" 2>/dev/null) || val="global"
		printf "  %-15s %s\n" "region" "$val"
		val=$(config_read "global" "lang" "" 2>/dev/null) || val="zh"
		printf "  %-15s %s\n" "lang" "$val"
		val=$(config_read "global" "file_logging" "" 2>/dev/null) || val="0"
		printf "  %-15s %s\n" "file_logging" "$val"
		return 0
	fi

	# 删除配置
	if [[ "${value}" == "--unset" ]]; then
		config_delete "global" "$key"
		log_success "已删除配置项: ${key}"
		return 0
	fi

	# 查询单个配置
	if [[ -z "$value" ]]; then
		local val
		val=$(config_read "global" "$key" "" 2>/dev/null) || val="(未设置)"
		echo "${key}=${val}"
		return 0
	fi

	# 写入配置
	config_write "global" "$key" "$value"
	log_success "已设置: ${key}=${value}"
}

# update 的 --unsigned 确认：醒目警告 + 交互输入 yes；非交互（stdin 非终端）直接拒绝，--yes 不能跳过
_update_confirm_unsigned() {
	local branch="$1"
	log_warning "================================================================"
	log_warning "  !!! 不校验模式：将直接下载分支 '${branch}' 的源码归档 !!!"
	log_warning "  不做 GPG 签名与 SHA256 校验，无法发现传输或托管平台上的篡改；"
	log_warning "  该代码将以 root 身份执行。仅供开发调试，请勿用于生产环境。"
	log_warning "================================================================"
	if [[ ! -t 0 ]]; then
		log_error "非交互环境下拒绝 --unsigned 更新"
		return 1
	fi
	local answer=""
	read -rp "确认安装未经校验的代码？请输入 yes 继续: " answer || answer=""
	if [[ "$answer" != "yes" ]]; then
		log_info "已取消"
		return 1
	fi
	return 0
}

# 子命令：update
# 用法：debnas update [--tag <版本>]          # 签名校验（默认更新到最新稳定版本）
#       debnas update --unsigned [--branch <分支>]  # 不校验（开发调试，需交互确认）
cmd_update() {
	local install_dir="/opt/debnas"
	local want_tag="" branch="" unsigned=0

	while [[ $# -gt 0 ]]; do
		case "$1" in
			--tag)
				if [[ $# -lt 2 ]] || ! installer_valid_tag "$2"; then
					log_error "--tag 需要一个合法的发布版本号（如 v3.1.0）"
					return 1
				fi
				want_tag="$2"
				shift 2
				;;
			--branch)
				if [[ $# -lt 2 ]] || ! installer_valid_branch "$2"; then
					log_error "--branch 需要一个合法的分支名（如 dev）"
					return 1
				fi
				branch="$2"
				shift 2
				;;
			--unsigned)
				unsigned=1
				shift
				;;
			*)
				log_error "update 不支持的参数: $1"
				echo "用法: debnas update [--tag <版本>] | --unsigned [--branch <分支>]"
				return 1
				;;
		esac
	done
	if [[ -n "$branch" && "$unsigned" -ne 1 ]]; then
		log_error "按分支更新不做任何完整性校验，必须显式加 --unsigned"
		return 1
	fi
	if [[ "$unsigned" -eq 1 && -n "$want_tag" ]]; then
		log_error "--tag 与 --unsigned 不能同时使用（指定 tag 时总是校验签名）"
		return 1
	fi
	[[ "$unsigned" -eq 1 && -z "$branch" ]] && branch="main"

	log_info "检查更新..."

	# 优先级：CLI/环境（parse_global_args 已合并到 DEBNAS_REGION）> 配置文件 > 默认 cn
	local region="${DEBNAS_REGION:-}"
	if [[ -z "$region" ]]; then
		region=$(config_read "global" "region" "" 2>/dev/null) || region=""
	fi
	if [[ -z "$region" ]]; then
		region="cn"
		log_warning "未找到 region 配置，使用默认值: ${region}"
	fi

	if [[ "$unsigned" -eq 1 ]]; then
		_update_confirm_unsigned "$branch" || return 1
	fi

	# 并发保护：整个更新过程持有 flock（与 install.sh 共用 DEBNAS_UPDATE_LOCK），进程退出自动释放
	deploy_lock || return 1
	deploy_recover "$install_dir" || return 1

	# 临时目录放在进程私有目录下，EXIT/INT/TERM 时由 tempfile.sh 的 trap 自动清理
	local tmp_dir
	tmp_dir=$(create_temp_dir "update") || { log_error "无法创建临时目录"; return 1; }
	local tarball="${tmp_dir}/debnas-update.tar.gz"
	local tag=""

	if [[ "$unsigned" -eq 1 ]]; then
		if ! installer_download_branch "$region" "$branch" "$tarball"; then
			rm -rf -- "${tmp_dir:?}"
			return 1
		fi
		log_warning "已跳过完整性校验（--unsigned）"
	else
		# 公钥只用已安装目录里的可信副本，不从网络获取
		local keyring="${tmp_dir}/release-keyring.gpg" fpr installed_tag
		if [[ -n "$want_tag" ]]; then
			# 显式指定版本：仍需加载公钥用于代码包验签（不做"最新版本"比较）
			if ! fpr=$(installer_load_release_key "$install_dir" "$keyring"); then
				log_error "已安装目录缺少有效的发布公钥（${install_dir}/keys/debnas-release.asc / .fpr）"
				log_error "可能原因：维护者尚未配置发布公钥，或当前安装来自未签名的旧版本"
				log_error "如确需更新未经校验的代码（风险自负）：debnas update --unsigned [--branch main]"
				rm -rf -- "${tmp_dir:?}"
				return 1
			fi
			# 缺少 RELEASE 标记（或标记里没有 tag）时退回用代码内的 DEBNAS_VERSION（tools/release.sh --bump 与 tag 同步），
			# 否则防降级检查形同虚设
			installed_tag=$(installer_marker_get "$install_dir" "tag")
			if [[ -z "$installed_tag" ]] && installer_valid_tag "${DEBNAS_VERSION:-}"; then
				installed_tag="$DEBNAS_VERSION"
			fi
			tag="$want_tag"
		else
			# 最新版本号优先取已签名的指针（main 分支 LATEST + LATEST.asc，用已安装的发布公钥验签）；
			# 自动发现的版本号只允许升级不允许降级（显式 --tag 可降级）：指针未签名时防伪造，已签名时防重放旧指针
			local rel_rc=0
			release_check_latest "$install_dir" "$tmp_dir" "$region" || rel_rc=$?
			tag="$_REL_LATEST_TAG"
			installed_tag="$_REL_INSTALLED_TAG"
			fpr="$_REL_FPR"
			case "$rel_rc" in
				0)
					log_success "已是最新版本：${tag}"
					rm -rf -- "${tmp_dir:?}"
					return 0
					;;
				2)
					case "${_REL_ERROR:-}" in
						no-key)
							log_error "已安装目录缺少有效的发布公钥（${install_dir}/keys/debnas-release.asc / .fpr）"
							log_error "可能原因：维护者尚未配置发布公钥，或当前安装来自未签名的旧版本"
							log_error "如确需更新未经校验的代码（风险自负）：debnas update --unsigned [--branch main]"
							;;
						untrusted)
							log_error "拒绝自动更新。确认来源可信后可用 --tag <版本> 指定版本（代码包仍校验发布签名）"
							;;
						older)
							log_error "远端最新版本 ${tag} 低于已安装版本 ${installed_tag}，拒绝自动降级（如确需降级请用 --tag ${tag}）"
							;;
						*)
							log_error "无法获取最新发布版本号（网络不可达或维护者尚未发布签名版本），可用 --tag 指定"
							;;
					esac
					rm -rf -- "${tmp_dir:?}"
					return 1
					;;
			esac
		fi
		log_info "目标版本：${tag}${installed_tag:+（已安装 ${installed_tag}）}"

		if ! installer_download_release "$region" "$tag" "$tmp_dir"; then
			rm -rf -- "${tmp_dir:?}"
			return 1
		fi
		if ! installer_verify_release "$tmp_dir" "debnas-${tag}.tar.gz" "$keyring" "$fpr"; then
			log_error "完整性校验未通过，已删除下载文件，更新中止"
			rm -rf -- "${tmp_dir:?}"
			return 1
		fi
		mv -f -- "${tmp_dir}/debnas-${tag}.tar.gz" "$tarball"
		log_success "签名与 SHA256 校验通过（签名者 ${fpr}）"
	fi

	local extract_dir="${tmp_dir}/extract"
	if ! installer_extract "$tarball" "$extract_dir"; then
		rm -rf -- "${tmp_dir:?}"
		return 1
	fi

	if ! installer_deploy "$extract_dir" "$install_dir"; then
		rm -rf -- "${tmp_dir:?}"
		return 1
	fi

	rm -rf -- "${tmp_dir:?}"

	if [[ "$unsigned" -eq 1 ]]; then
		installer_marker_write "$install_dir" "" "$branch" 0 || true
	else
		installer_marker_write "$install_dir" "$tag" "" 1 || true
	fi
	# 已更新到最新：清掉首页"有新版本"提示缓存
	update_check_cache_clear

	# 迁移必须由"新代码"执行：当前进程加载的是旧版本的 DEBNAS_VERSION 与 _migrate_* 函数，
	# 在此直接调用 migration_run 永远检测不到版本变化，新版本的迁移步骤也不会被执行
	if ! (unset _DEBNAS_BOOTSTRAPPED _DEBNAS_CORE_LOADED; bash -c 'source "$1/lib/bootstrap.sh" && migration_run' _ "/opt/debnas") 2>/dev/null; then
		log_warning "版本迁移存在问题，请运行 debnas doctor 检查"
	fi
	# 刷新全局命令包装脚本：同样由"新代码"生成内容（旧版包装脚本或软链接在此被替换）
	if ! (unset _DEBNAS_BOOTSTRAPPED _DEBNAS_CORE_LOADED; bash -c 'source "$1/lib/bootstrap.sh" && deploy_install_wrapper "$2" "$1"' _ "/opt/debnas" "/usr/local/bin/debnas") 2>/dev/null; then
		log_warning "全局命令 /usr/local/bin/debnas 未能刷新，可重新执行 install.sh 修复"
	fi
	deploy_unlock

	log_success "DebNAS 更新完成"
	return 0
}

# 子命令：check-update（只读版本检测）
# 用法：debnas check-update
# 输出：当前版本 / 最新版本 / 结论
# 退出码：0=已是最新  1=有新版本  2=检查失败（公钥缺失 / 指针验签失败 / 网络不可达 / 指针回放）
# 说明：只读版本指针，不下载发布包、不持部署锁、不修改安装目录
cmd_check_update() {
	local install_dir="/opt/debnas"
	# 开发态（直接从源码目录运行）没有安装标记，用当前代码版本与仓库内的公钥比较
	[[ -d "$install_dir" ]] || install_dir="${_DEBNAS_ROOT:-${DEBNAS_ROOT:-.}}"

	local region
	# 优先级：CLI/环境（parse_global_args 已合并到 DEBNAS_REGION）> 配置文件 > 默认 cn
	local region="${DEBNAS_REGION:-}"
	if [[ -z "$region" ]]; then
		region=$(config_read "global" "region" "" 2>/dev/null) || region=""
	fi
	if [[ -z "$region" ]]; then
		region="cn"
	fi

	local tmp_dir
	tmp_dir=$(create_temp_dir "check-update") || { log_error "无法创建临时目录"; return 2; }

	local rel_rc=0
	release_check_latest "$install_dir" "$tmp_dir" "$region" || rel_rc=$?
	rm -rf -- "${tmp_dir:?}"

	local current="${_REL_INSTALLED_TAG:-${DEBNAS_VERSION:-未知}}"
	local latest="${_REL_LATEST_TAG:-未知}"

	log_info "当前版本：${current}"
	if [[ -n "${_REL_LATEST_TAG:-}" ]]; then
		log_info "最新版本：${latest}"
	fi

	case "$rel_rc" in
		0)
			log_success "已是最新版本"
			return 0
			;;
		1)
			log_warning "发现新版本：${latest}，可用 debnas update 更新"
			return 1
			;;
	esac

	# 失败原因与菜单共用同一套措辞（installer.sh 的 release_check_error_text）
	if [[ "${_REL_ERROR:-}" == "older" ]]; then
		log_warning "$(release_check_error_text "$_REL_ERROR" "$latest" "$current")"
	else
		log_error "检查失败：$(release_check_error_text "${_REL_ERROR:-}" "$latest" "$current")"
	fi
	return 2
}

# 子命令：uninstall
cmd_uninstall() {
	log_warning "此操作将移除 DebNAS 所有脚本文件、配置和日志。"
	log_warning "不会恢复已安装的软件包或已修改的系统配置。"

	if [[ "${DEBNAS_FORCE_YES:-0}" -ne 1 ]]; then
		local confirm=""
		# EOF 时 read 返回非 0，set -e 下会静默退出，按"取消"处理
		read -rp "确认继续？[y/N]: " confirm || confirm=""
		if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
			log_info "已取消卸载"
			return 0
		fi
	fi

	local uninstall_failed=0
	if rm -f /usr/local/bin/debnas 2>/dev/null; then
		log_info "已移除全局命令: /usr/local/bin/debnas"
	else
		log_warning "未能移除全局命令: /usr/local/bin/debnas"
		uninstall_failed=1
	fi
	if rm -rf /opt/debnas 2>/dev/null; then
		log_info "已移除脚本目录: /opt/debnas/"
	else
		log_warning "未能移除脚本目录: /opt/debnas/"
		uninstall_failed=1
	fi

	local current_crontab
	current_crontab=$(crontab -l 2>/dev/null || true)
	if [[ "$current_crontab" == *DEBNAS-CRON* ]]; then
		# 只删除 DebNAS 条目：过滤后为空才 crontab -r；crontab - 写入失败不得回退为
		# crontab -r（会删除用户全部定时任务），只告警并保留原内容
		local filtered="" grep_rc=0
		filtered=$(printf '%s\n' "$current_crontab" | grep -v "DEBNAS-CRON") || grep_rc=$?
		if [[ "$grep_rc" -eq 0 ]]; then
			if [[ -z "$filtered" ]]; then
				crontab -r 2>/dev/null || true
			elif ! printf '%s\n' "$filtered" | crontab - 2>/dev/null; then
				log_warning "清理 DebNAS 定时任务失败，请手动检查 root crontab"
			fi
			log_info "已移除 DebNAS 定时任务"
		elif [[ "$grep_rc" -eq 1 ]]; then
			# 全部条目都是 DebNAS 管理：直接移除整份 crontab
			crontab -r 2>/dev/null || true
			log_info "已移除 DebNAS 定时任务"
		else
			log_warning "读取/过滤 crontab 失败，未修改定时任务"
		fi
	fi

	# 登录通知：移除 PAM 行与辅助脚本目录（否则 PAM 会引用已删除的脚本）
	login_notify_pam_sync "" >/dev/null 2>&1 || true
	if [[ -n "${DEBNAS_LIBEXEC_DIR:-}" && -d "$DEBNAS_LIBEXEC_DIR" ]]; then
		if rm -rf -- "$DEBNAS_LIBEXEC_DIR"; then
			log_info "已移除辅助脚本目录: ${DEBNAS_LIBEXEC_DIR}/"
		else
			log_warning "未能移除辅助脚本目录: ${DEBNAS_LIBEXEC_DIR}/"
			uninstall_failed=1
		fi
	fi
	# 通知邮箱兼容链接（/etc/exim4/notify_email -> /etc/debnas/notify_email），删除配置目录后会悬空
	if [[ -n "${DEBNAS_LEGACY_NOTIFY_EMAIL_FILE:-}" && -L "$DEBNAS_LEGACY_NOTIFY_EMAIL_FILE" ]]; then
		rm -f -- "$DEBNAS_LEGACY_NOTIFY_EMAIL_FILE"
	fi
	# 文件清单随 /var/lib/debnas 删除，先留一份到备份目录；备份目录默认保留
	if [[ -f "${DEBNAS_MANIFEST_FILE:-}" && -d "${DEBNAS_BACKUP_ROOT:-}" ]]; then
		cp -p -- "$DEBNAS_MANIFEST_FILE" "${DEBNAS_BACKUP_ROOT}/manifest.uninstalled" 2>/dev/null || true
	fi

	for _dir in /etc/debnas /var/log/debnas /var/lib/debnas /tmp/debnas; do
		if rm -rf "$_dir" 2>/dev/null; then
			log_info "已移除目录: ${_dir}/"
		else
			log_warning "未能移除目录: ${_dir}/"
			uninstall_failed=1
		fi
	done
	unset _dir
	# root 的临时基目录已改为 /run/debnas（本进程仍在使用，退出时由 tempfile.sh 清理 PID 子目录）
	# 被中断的部署残留
	rm -rf /opt/.debnas.old /opt/.debnas.new 2>/dev/null || true

	if [[ "$uninstall_failed" -ne 0 ]]; then
		log_warning "部分文件未能移除，请按上方提示手动检查"
		return 1
	fi
	log_success "DebNAS 已卸载"
	log_info "已安装的软件包和系统配置未被修改。如需恢复系统，请手动操作。"
	[[ -n "${DEBNAS_BACKUP_ROOT:-}" ]] && log_info "被修改系统文件的原件保留在 ${DEBNAS_BACKUP_ROOT}/（含 original/ 首次修改前版本），确认不需要后可手动删除"
	return 0
}

# 子命令：files — 列出 DebNAS 自有目录、修改过的系统文件、定时任务与审计目录
cmd_files() {
	manifest_list
}

# 子命令：doctor
cmd_doctor() {
	unset _DEBNAS_BOOTSTRAPPED
	exec bash "${_DEBNAS_ROOT}/bin/doctor.sh" "$@"
}

# 子命令：cron
cmd_cron() {
	local subcmd="${1:-}"
	shift || true

	case "$subcmd" in
		add|enable)
			if [[ $# -eq 0 ]]; then
				log_error "用法: debnas cron enable|add <模块名> [cron 表达式]"
				return 1
			fi
			local module_name="$1"
			local schedule="${2:-}"

			discover_modules 2>/dev/null
			if ! module_exists "$module_name"; then
				log_error "模块不存在：${module_name}"
				return 1
			fi

			if [[ -z "$schedule" ]]; then
				schedule=$(get_module_field "$module_name" "cron_schedule" "" 2>/dev/null) || schedule=""
			fi

			if [[ -z "$schedule" ]]; then
				log_error "模块 ${module_name} 未声明 cron_schedule，请手动指定"
				log_error "用法: debnas cron enable ${module_name} \"0 0 * * *\""
				return 1
			fi

			if ! feature_enabled "$module_name"; then
				log_warning "${module_name} 功能未启用，将自动启用"
				if ! (unset _DEBNAS_BOOTSTRAPPED; trap - INT; bash "${_DEBNAS_ROOT}/bin/module-runner.sh" "$module_name" enable); then
					log_error "自动启用 ${module_name} 失败"
					return 1
				fi
			fi

			if cron_register "$module_name" "$schedule"; then
				log_success "已启用 ${module_name} 定时任务：${schedule}（$(cron_describe "$schedule")）"
			else
				log_error "定时任务注册失败：${schedule}"
				return 1
			fi
			;;

		remove|disable)
			if [[ $# -eq 0 ]]; then
				log_error "用法: debnas cron disable|remove <模块名>"
				return 1
			fi
			if cron_unregister "$1"; then
				log_success "已禁用 ${1} 定时任务"
			else
				log_error "定时任务移除失败：${1}"
				return 1
			fi
			;;

		list)
			cron_list
			;;

		"")
			log_error "cron 子命令需要指定操作"
			echo "用法: debnas cron enable|disable|list"
			return 1
			;;

		*)
			log_error "未知的 cron 操作: ${subcmd}"
			echo "支持的操作: enable, disable, list (兼容 add/remove)"
			return 1
			;;
	esac
}

# ==================== 主路由 ====================

main() {
	# 清理上次被中断残留的信号哨兵（仅在基目录属于当前用户时操作）
	if [[ -f "${_DEBNAS_SIGNAL_SENTINEL:-}" ]] && _temp_dir_owned_by_me "$DEBNAS_TMP_BASE"; then
		rm -f "$_DEBNAS_SIGNAL_SENTINEL" 2>/dev/null || true
	fi

	# 解析全局参数（--help / --version 在此退出）
	parse_global_args "$@"

	# 权限检查（除 --help/--version 外，所有操作都需要 root）
	if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
		log_error "需要 root 权限（请使用 su - 切换到 root 用户后执行）"
		exit "${ERROR_PERMISSION:-4}"
	fi

	# 上次更新被中断（SIGKILL/断电）留下的部署残留：自动回滚或清理（锁被占用时跳过）
	if [[ "$_DEBNAS_ROOT" == "/opt/debnas" ]]; then
		deploy_recover "/opt/debnas" || true
		# 全局命令包装脚本过期（或仍是旧版软链接）时换成当前版本的内容：执行更新的是旧代码，
		# 旧版 update 不刷新包装脚本，升级后首次启动在这里补上；内容一致时不写
		if [[ -e /usr/local/bin/debnas || -L /usr/local/bin/debnas ]]; then
			deploy_install_wrapper "/usr/local/bin/debnas" "/opt/debnas" 2>/dev/null || true
		fi
	fi

	# 获取剩余参数
	local -a args=("${DEBNAS_REMAINING_ARGS_ARRAY[@]+"${DEBNAS_REMAINING_ARGS_ARRAY[@]}"}")

	# 处理 --cron 触发模式：debnas <module> --cron → debnas run <module>
	# parse_global_args 已消费 --cron 并设置 DEBNAS_CRON_MODE；剩余参数只有模块名时补 run
	if [[ "${DEBNAS_CRON_MODE:-0}" -eq 1 && ${#args[@]} -ge 1 ]]; then
		case "${args[0]}" in
			install|run|config|update|check-update|uninstall|doctor|files|cron) ;;
			*) args=(run "${args[@]}") ;;
		esac
	fi

	# 提取子命令
	local subcmd="${args[0]:-}"
	local -a subcmd_args=()
	if [[ ${#args[@]} -gt 1 ]]; then
		subcmd_args=("${args[@]:1}")
	fi

	# 无子命令时：检测是否有 CLI 显式传递的全局参数（非配置文件来源）
	if [[ -z "$subcmd" ]]; then
		if [[ "${_DEBNAS_CLI_FLAGS:-0}" -eq 1 ]]; then
			log_error "全局参数需要配合子命令使用"
			echo "临时使用: debnas --region cn install <模块名>"
			echo "持久设置: debnas config region cn"
			return 1
		fi
	fi

	case "$subcmd" in
		"")
			cmd_menu "${subcmd_args[@]+"${subcmd_args[@]}"}"
			;;

		install|run)
			cmd_install "${subcmd_args[@]+"${subcmd_args[@]}"}"
			;;

		config)
			cmd_config "${subcmd_args[@]+"${subcmd_args[@]}"}"
			;;

		update)
			cmd_update "${subcmd_args[@]+"${subcmd_args[@]}"}"
			;;

		check-update)
			cmd_check_update "${subcmd_args[@]+"${subcmd_args[@]}"}"
			;;

		uninstall)
			cmd_uninstall "${subcmd_args[@]+"${subcmd_args[@]}"}"
			;;

		doctor)
			cmd_doctor "${subcmd_args[@]+"${subcmd_args[@]}"}"
			;;

		files)
			cmd_files "${subcmd_args[@]+"${subcmd_args[@]}"}"
			;;

		cron)
			cmd_cron "${subcmd_args[@]+"${subcmd_args[@]}"}"
			;;

		*)
			log_error "未知子命令: ${subcmd}"
			print_usage
			echo "使用 --help 查看完整帮助"
			return 1
			;;
	esac
}

main "$@"
